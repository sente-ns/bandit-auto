# bandit-auto configuration
# Copy this file to .env and adjust values as needed.
# .env is listed in .gitignore and will never be committed.
#
# All variables are OPTIONAL — the defaults shown here match the
# live OverTheWire Bandit infrastructure and are safe to use as-is.

# ── Target host ───────────────────────────────────────────────────────────────
BANDIT_HOST=bandit.labs.overthewire.org
BANDIT_PORT=2220

# ── Timeouts (seconds) ────────────────────────────────────────────────────────
BANDIT_CONNECT_TIMEOUT=15
BANDIT_EXEC_TIMEOUT=30

# ── Rate-limiting & jitter ────────────────────────────────────────────────────
# Sleep between levels = BANDIT_CONNECT_PAUSE + uniform(-JITTER/2, +JITTER)
BANDIT_CONNECT_PAUSE=2.0
BANDIT_CONNECT_JITTER=1.0

# ── Retry / exponential backoff (v6.3) ───────────────────────────────────────
# OTW Bandit throttles rapid SSH connections at the banner phase.
# The retry system handles SSHException / socket.error / EOFError / OSError.
#
# Schedule with defaults (jitter excluded):
#   attempt 1 — immediate
#   attempt 2 — ~3 s   (BACKOFF × 2^0)
#   attempt 3 — ~6 s   (BACKOFF × 2^1)
#   attempt 4 — ~12 s  (BACKOFF × 2^2)
BANDIT_MAX_RETRIES=4
BANDIT_RETRY_BACKOFF=3.0
BANDIT_RETRY_WAIT_CAP=30.0

# ── Output paths ──────────────────────────────────────────────────────────────
# Password output file (created with mode 0600, exclusively locked)
BANDIT_PASSWORD_FILE=bandit_passwords.txt

# Path to pre-scanned host keys (see README — Setup section)
# Generate with: ssh-keyscan -p 2220 bandit.labs.overthewire.org > bandit_known_hosts
# BANDIT_KNOWN_HOSTS=bandit_known_hosts
